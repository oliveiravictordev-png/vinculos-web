# Serve o build estático e repassa /api para a API: mesma origem no navegador, sem CORS.
# ${API_URL} é substituído na subida do container (envsubst da imagem oficial do nginx).
server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
